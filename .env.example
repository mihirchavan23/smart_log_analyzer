# AI Provider Selection: gemini | openai | grok
AI_PROVIDER=gemini

# Google Gemini API Key (Official @google/genai SDK)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# xAI Grok API Key (Optional)
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Server Port
PORT=3000
