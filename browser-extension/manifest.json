{
  "manifest_version": 3,
  "name": "Smart Log Analyzer - Tab Monitor",
  "version": "1.0.0",
  "description": "Lightweight privacy-safe browser tab telemetry monitor for Smart Log Analyzer.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Log Analyzer Monitor"
  }
}
